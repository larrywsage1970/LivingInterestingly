# Copy to .env (never commit .env). All values are read from the environment.

# Required by NWS: identify the app and give a contact address.
SGW_USER_AGENT="GRID/0.1 (contact: you@example.com)"

# SQLite file location (mount a volume here in production).
SGW_DB_PATH=./data/sgw.sqlite3

# Location config file.
SGW_LOCATIONS_FILE=./locations.json

# Set to 0 to disable background polling (tests, local UI work).
SGW_POLL=1

# EPA AirNow key (free, docs.airnowapi.org)
AIRNOW_API_KEY=

# Phase 7+ (not used yet)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# ASK_PASSCODE=
